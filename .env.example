# ============================================================
# MailPort 环境变量 / Environment variables
# 复制为 .env 并填写 / Copy to .env and fill in
# ============================================================

# ---- 必填 / Required ----

# 管理员登录密码 / Admin login password
ADMIN_PASSWORD=

# 应用主密钥:用于加密 SMTP 凭据与签名会话 Cookie,至少 32 字符
# App secret: encrypts SMTP credentials and signs session cookies (>= 32 chars)
MAILPORT_SECRET=

# ---- 数据库(按需配置一组,自动识别)/ Database (configure one group) ----

# PostgreSQL / Supabase / Neon / Tembo
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=
PG_USER=
PG_PASSWORD=
PG_SSL=false
# 兼容写法 / Aliases
# POSTGRES_HOST / POSTGRES_PORT / POSTGRES_DATABASE / POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_SSL

# MySQL / TiDB(协议兼容,直接用 MySQL 配置)/ PlanetScale / FreeDB
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=false

# MongoDB(Atlas 等)/ MongoDB
MONGO_HOST=
MONGO_PORT=27017
MONGO_DB=
MONGO_USER=
MONGO_PASSWORD=
MONGO_REPLICASET=
MONGO_AUTHSOURCE=admin
MONGO_OPT_SSL=true

# SQLite(仅本地/自托管,Vercel Serverless 不可用)
# SQLite (local/self-hosted only; not usable on Vercel Serverless)
SQLITE_PATH=./data
SQLITE_DB=mailport.db

# ---- 可选 / Optional ----

# 会话有效期(秒),默认 7 天 / Session TTL in seconds (default 7d)
SESSION_TTL=604800

# 时区 / Timezone
TZ=UTC
